"""Generate all report figures from results.csv."""
from pathlib import Path
import csv
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np

BASE = Path(__file__).resolve().parent
ALGORITHMS = ("insertion", "merge", "gnome")
SHAPES = ("random", "sorted", "reverse", "duplicates")
SIZES = (1000, 2000, 4000, 8000)

def read_data():
    data = {}
    with (BASE / "results.csv").open(encoding="utf-8", newline="") as f:
        for r in csv.DictReader(f):
            key = (r["shape"], int(r["n"]), r["algorithm"])
            data[key] = {
                "time_ms": float(r["time_ms"]),
                "comparisons": int(r["comparisons"]),
                "moves": int(r["moves"]),
            }
    return data

def grouped_bars(data, field, ylabel, filename):
    x = np.arange(len(SHAPES))
    width = 0.22
    fig, ax = plt.subplots(figsize=(8.5, 4.7))
    for k, alg in enumerate(ALGORITHMS):
        y = [data[(shape, 8000, alg)][field] for shape in SHAPES]
        ax.bar(x + (k-1)*width, y, width, label=alg.capitalize())
    ax.set_xticks(x, [s.capitalize() for s in SHAPES])
    ax.set_ylabel(ylabel)
    ax.set_title(f"{ylabel} by input type (n = 8,000)")
    ax.grid(axis="y", alpha=.22)
    ax.set_axisbelow(True)
    ax.legend()
    fig.tight_layout()
    fig.savefig(BASE / filename, dpi=180)
    plt.close(fig)

def growth_plot(data, field, ylabel, filename):
    fig, ax = plt.subplots(figsize=(8.5, 4.7))
    for alg in ALGORITHMS:
        y = [data[("random", n, alg)][field] for n in SIZES]
        ax.plot(SIZES, y, marker="o", linewidth=2, label=alg.capitalize())
    ax.set_yscale("log")
    ax.set_xticks(SIZES)
    ax.set_xlabel("Input size n")
    ax.set_ylabel(ylabel)
    ax.set_title(f"{ylabel} as random input grows")
    ax.grid(True, which="both", alpha=.22)
    ax.legend()
    fig.tight_layout()
    fig.savefig(BASE / filename, dpi=180)
    plt.close(fig)

def gnome_states(values):
    a = list(values)
    states = [a.copy()]
    i = 1
    while i < len(a):
        if i == 0 or a[i-1] <= a[i]:
            i += 1
        else:
            a[i-1], a[i] = a[i], a[i-1]
            states.append(a.copy())
            i -= 1
    return states

def gnome_figure():
    states = gnome_states([4, 2, 3, 1])
    fig, ax = plt.subplots(figsize=(7.4, 5))
    ax.axis("off")
    for step, state in enumerate(states):
        y = len(states)-1-step
        ax.text(-.6, y, "Start" if step == 0 else f"Swap {step}",
                ha="right", va="center")
        for j, v in enumerate(state):
            ax.text(j, y, str(v), ha="center", va="center", fontsize=14,
                    bbox=dict(boxstyle="round,pad=.45", fill=False))
    ax.set_xlim(-1.5, 3.7)
    ax.set_ylim(-.7, len(states)-.2)
    ax.set_title("Gnome sort: swap sequence for [4, 2, 3, 1]")
    fig.tight_layout()
    fig.savefig(BASE / "gnome_process.png", dpi=180)
    plt.close(fig)

def main():
    data = read_data()
    grouped_bars(data, "comparisons", "Key comparisons", "shape_comparisons.png")
    grouped_bars(data, "time_ms", "Mean time (ms)", "shape_time.png")
    grouped_bars(data, "moves", "Item assignments", "shape_moves.png")
    growth_plot(data, "comparisons", "Key comparisons", "growth_comparisons.png")
    growth_plot(data, "time_ms", "Mean time (ms)", "growth_time.png")
    gnome_figure()
    print("Figures generated from results.csv")

if __name__ == "__main__":
    main()
